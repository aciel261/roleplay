# Salin nilai-nilai ini ke Vercel: Project Settings > Environment Variables
# (JANGAN commit file .env asli ke GitHub)

# Wajib - API key Claude kamu (hanya dipakai di server, tidak pernah sampai ke browser)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Wajib - Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...   # anon / publishable key (aman terlihat publik)

# Opsional - batasi siapa yang boleh memakai AI (pisahkan dengan koma). Kosong = semua akun terdaftar.
ALLOWED_EMAIL_DOMAINS=

# Opsional - ganti model. Default sudah diisi.
MODEL_QUICK=claude-haiku-5-5
MODEL_DEFAULT=claude-sonnet-5-5

# Opsional - batas permintaan AI per user per menit (default 20)
RATE_LIMIT_PER_MIN=20
